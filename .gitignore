# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes

# Editors / IDEs
.idea/
.vscode/
*.swp
*~

# --- frontend -------------------------------------------------------------
frontend/node_modules/
frontend/dist/
frontend/coverage/
frontend/.vite/
frontend/*.tsbuildinfo
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- backend --------------------------------------------------------------
# Compiled binaries from `go build` in the module root.
backend/server
backend/uraractl
backend/*.test
backend/*.out
backend/coverage.out
backend/coverage.html

# --- chat -----------------------------------------------------------------
# uv writes .venv/.gitignore, and ruff, mypy and pytest each ignore their own
# cache, so only the bytecode needs naming here.
chat/**/__pycache__/
chat/**/*.pyc
chat/.venv/

# --- local run state ------------------------------------------------------
# Written by the Makefile's k8s port-forward targets.
.k8s-portforward.pid
.k8s-portforward.log

# Scratch output.
*.local.yaml

# --- CI -------------------------------------------------------------------
# Rendered manifests, written by the manifests workflow.
/dev.yaml
/prod.yaml
# Test output tee'd by the backend workflow's integration step.
backend/integration.log

# A local compose override, which is how the chat service is pointed at the
# host's gcloud credentials for Vertex. Machine-specific, so not committed.
docker-compose.override.yml

# Environment overrides; the committed defaults live in docker-compose.yml.
.env
.env.*
!.env.example

# Chris personal notes
dev_notes/

# The junit report the chat CI job writes; only act leaves it in the tree.
chat/report.xml

# The requirements file the security workflow exports for pip-audit.
chat/requirements.txt
