# Model credentials for the chat service.
#
# Copy to .env and fill in one of the two paths below. .env is gitignored; this
# file is committed and must never carry a real value.
#
#   cp .env.example .env
#
# Everything else the stack needs is a committed default in docker-compose.yml.
# These are here because a model credential is the one thing that cannot be.

# --- Google AI Studio (the default) ----------------------------------------
# A key from https://aistudio.google.com/app/apikey. Nothing else to set up.
GOOGLE_API_KEY=

# --- Or Vertex AI ----------------------------------------------------------
# Authenticates with Application Default Credentials, so there is no key. Run
# `gcloud auth application-default login` first, and see chat/README.md for the
# volume mount compose needs to see those credentials.
# LLM_PROVIDER=vertex
# VERTEX_PROJECT=
# VERTEX_LOCATION=us-central1

# --- Optional --------------------------------------------------------------
# LLM_MODEL=gemini-2.5-flash
