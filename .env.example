# Model credentials for the chat service, and the bootstrap admin.
#
# Copy to .env and fill in VERTEX_PROJECT. .env is gitignored; this
# file is committed and must never carry a real value.
#
#   cp .env.example .env
#
# Everything else the stack needs is a committed default in docker-compose.yml.
# These are here because a model credential is the one thing that cannot be.

# --- Vertex AI -------------------------------------------------------------
# Authenticates with Application Default Credentials, so there is no key. Run
# `gcloud auth application-default login` first, and see
# docs/tech/architecture/deployment.md for the mount compose needs.
VERTEX_PROJECT=
# LLM_PROVIDER=vertex
# VERTEX_LOCATION=us-central1

# --- Optional --------------------------------------------------------------
# LLM_MODEL=gemini-2.5-flash

# The first admin, created only while the users table is empty. Defaults are
# the committed dev values in docker-compose.yml.
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=relviz-dev-admin-password
